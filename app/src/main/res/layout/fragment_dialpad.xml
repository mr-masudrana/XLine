<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Header: SIP identity + status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface"
        android:paddingHorizontal="24dp"
        android:paddingVertical="18dp">

        <TextView
            android:id="@+id/myIdentityText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="21sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_status_dot_offline" />

            <TextView
                android:id="@+id/statusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Offline"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- Number entry -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
        android:id="@+id/numberDisplay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:hint="Enter number"
        android:textColorHint="@color/text_hint"
        android:textColor="@color/text_primary"
        android:textSize="36sp"
        android:padding="12dp" />

        <TextView
            android:id="@+id/contactPreviewText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Enter SIP number"
            android:textSize="14sp"
            android:alpha="0.65"
            android:maxLines="1"/>
    </LinearLayout>

    <!-- Dial grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingBottom="8dp">

        <LinearLayout style="@style/DialRow">
            <TextView style="@style/DialKey" android:id="@+id/key1" android:text="1" />
            <TextView style="@style/DialKey" android:id="@+id/key2" android:text="2" />
            <TextView style="@style/DialKey" android:id="@+id/key3" android:text="3" />
        </LinearLayout>
        <LinearLayout style="@style/DialRow">
            <TextView style="@style/DialKey" android:id="@+id/key4" android:text="4" />
            <TextView style="@style/DialKey" android:id="@+id/key5" android:text="5" />
            <TextView style="@style/DialKey" android:id="@+id/key6" android:text="6" />
        </LinearLayout>
        <LinearLayout style="@style/DialRow">
            <TextView style="@style/DialKey" android:id="@+id/key7" android:text="7" />
            <TextView style="@style/DialKey" android:id="@+id/key8" android:text="8" />
            <TextView style="@style/DialKey" android:id="@+id/key9" android:text="9" />
        </LinearLayout>
        <LinearLayout style="@style/DialRow">
            <TextView style="@style/DialKey" android:id="@+id/keyStar" android:text="*" />
            <TextView style="@style/DialKey" android:id="@+id/key0" android:text="0" />
            <TextView style="@style/DialKey" android:id="@+id/keyHash" android:text="#" />
        </LinearLayout>
    </LinearLayout>

    <!-- Call / backspace row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="14dp">

        <ImageButton
            android:id="@+id/callButton"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_call_button"
            android:src="@drawable/ic_call"
            android:padding="16dp"
            android:contentDescription="Call" />

        <ImageButton
            android:id="@+id/backspaceButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_input_delete"
            android:contentDescription="Backspace" />
    </RelativeLayout>

</LinearLayout>
