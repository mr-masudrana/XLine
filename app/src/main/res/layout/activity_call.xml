<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="72dp"
    android:paddingHorizontal="24dp">

    <FrameLayout
        android:layout_width="140dp"
        android:layout_height="140dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_avatar_circle" />

        <TextView
            android:id="@+id/avatarInitial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/primary"
            android:textSize="52sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/remoteNameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/remoteUriText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/callStatusBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_status_badge"
        android:paddingHorizontal="18dp"
        android:paddingVertical="8dp"
        android:text="Ringing…"
        android:textColor="@color/badge_amber_text"
        android:textStyle="bold"
        android:textSize="13sp" />

    <!-- Incoming call actions (hidden for outgoing calls) -->
    <LinearLayout
        android:id="@+id/incomingActionsRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/answerButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="Answer"
            android:textAllCaps="false"
            app:backgroundTint="@color/online_green"
            app:cornerRadius="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/declineButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Decline"
            android:textAllCaps="false"
            app:backgroundTint="@color/danger_red"
            app:cornerRadius="24dp" />
    </LinearLayout>

    <!-- Spacer -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- In-call controls (mute / speaker) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="32dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="48dp">

            <ImageButton
                android:id="@+id/muteButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_toggle_button"
                android:src="@drawable/ic_mic"
                android:padding="18dp"
                android:contentDescription="Mute" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Mute"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/speakerButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_toggle_button"
                android:src="@drawable/ic_speaker"
                android:padding="18dp"
                android:contentDescription="Speaker" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Speaker"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hang up -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="48dp">

        <ImageButton
            android:id="@+id/hangupButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_hangup_button"
            android:src="@drawable/ic_call_end"
            android:padding="20dp"
            android:contentDescription="Hang up" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Hang up"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
