<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><ImageButton android:id="@+id/backButton" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="Back" android:src="@android:drawable/ic_media_previous"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:text="SIP Account" android:textSize="26sp" android:textStyle="bold"/><TextView android:text="Configure your server and registration" android:textSize="13sp" android:alpha="0.65"/></LinearLayout></LinearLayout>
<TextView android:id="@+id/registrationStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:padding="14dp" android:text="Checking registration…" android:textStyle="bold" android:background="@drawable/bg_status_pill"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="ACCOUNT" android:textStyle="bold" android:textSize="12sp"/>
<EditText android:id="@+id/accountName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Account name"/>
<EditText android:id="@+id/username" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="SIP username" android:inputType="text"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><EditText android:id="@+id/password" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Password" android:inputType="textPassword"/><ImageButton android:id="@+id/passwordToggle" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="Show password" android:src="@android:drawable/ic_menu_view"/></LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="SERVER" android:textStyle="bold" android:textSize="12sp"/>
<EditText android:id="@+id/domain" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Server / domain" android:inputType="textUri"/>
<EditText android:id="@+id/port" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Port" android:inputType="number"/>
<EditText android:id="@+id/proxy" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Outbound proxy (optional)" android:inputType="textUri"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="TRANSPORT" android:textStyle="bold" android:textSize="12sp"/>
<Spinner android:id="@+id/transport" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="horizontal"><Button android:id="@+id/testButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Test"/><Button android:id="@+id/saveButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Save &amp; Register"/></LinearLayout>
<TextView android:id="@+id/errorText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="13sp" android:visibility="gone"/>
</LinearLayout></ScrollView>
